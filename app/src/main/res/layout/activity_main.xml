<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090B12"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AI VIDEO • MOBILE"
            android:textColor="#8BE9FD"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Локальный Image → Video на Android • MobileI2V"
            android:textColor="#C8CFDF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/deviceInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#151A26"
            android:padding="16dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <Button
            android:id="@+id/imageButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Выбрать изображение" />

        <TextView
            android:id="@+id/imageStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#151A26"
            android:padding="12dp"
            android:text="Изображение пока не выбрано"
            android:textColor="#C8CFDF"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/prompt"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="16dp"
            android:background="#151A26"
            android:gravity="top|start"
            android:hint="Опишите движение или сцену (необязательно)..."
            android:inputType="textMultiLine"
            android:padding="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#6F7890" />

        <Button
            android:id="@+id/modelPackButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Установить MobileI2V model pack (ZIP)" />

        <Button
            android:id="@+id/checkButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Проверить мобильный движок" />

        <TextView
            android:id="@+id/engineStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#151A26"
            android:padding="16dp"
            android:textColor="#C8CFDF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/generateButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Создать видео на телефоне" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="ZIP принимается только после проверки manifest.json и SHA-256 каждого файла модели. Генерация пока не имитируется."
            android:textColor="#7F899F"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
